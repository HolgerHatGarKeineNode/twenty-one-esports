APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en

# Placeholder admin gate until P3: comma-separated e-mail addresses
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Production runs PostgreSQL (Forge). Keep migrations and queries driver-agnostic.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=twentyone
# DB_USERNAME=twentyone
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Relays the league publishes signed events to (comma-separated). Local: the ndak
# test bed. Never a public relay without the user's approval.
ESPORTS_RELAYS=ws://127.0.0.1:7777,ws://127.0.0.1:7780,ws://127.0.0.1:7782
# Game chat relays (NIP-17 gift wraps); default: ESPORTS_RELAYS.
# ESPORTS_CHAT_RELAYS=
# Notification key (hex or nsec) for NIP-17 DMs; its own key, never the league key.
ESPORTS_NOTIFICATION_NSEC=
# Web Push VAPID keys (php artisan esports:vapid-keys). Never commit real keys.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=

# Pre-Season: planned Block 0 (ISO 8601 with offset), pot in sats, genesis message.
ESPORTS_BLOCK0_AT=
ESPORTS_PRESEASON_POT_SATS=
ESPORTS_GENESIS_MESSAGE=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Production uses the portal's Reverb server as a second app (no own reverb:start):
#   REVERB_HOST=ws.portal.einundzwanzig.space  REVERB_PORT=443  REVERB_SCHEME=https
#   REVERB_APP_ID / REVERB_APP_KEY / REVERB_APP_SECRET = the portal's REVERB_ESPORTS_APP_* values
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

TWENTYONE_NOSTR_NSEC=
TWENTYONE_NOSTR_NPUB=
TWENTYONE_STREAM_SOURCE=
TWENTYONE_STREAM_PREPARED=
TWENTYONE_STREAM_HLS_DIR=
TWENTYONE_STREAM_URL=
TWENTYONE_STREAM_FFMPEG=
TWENTYONE_STREAM_FFPROBE=
