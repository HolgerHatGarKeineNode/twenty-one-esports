APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en

# Placeholder admin gate until P3: comma-separated e-mail addresses
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Production runs PostgreSQL (Forge). Keep migrations and queries driver-agnostic.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=twentyone
# DB_USERNAME=twentyone
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Production: redis, run by Laravel Horizon (Forge daemon `php artisan horizon`,
# deploy script `php artisan horizon:terminate`). Locally database or sync is fine.
QUEUE_CONNECTION=database

# Relays the league publishes signed events to (comma-separated). Local: the ndak
# test bed. Unset or empty in production: the public default set in
# config/esports.php (primal, nostr.mom, damus, nos.lol, snort, offchain, …).
ESPORTS_RELAYS=ws://127.0.0.1:7777,ws://127.0.0.1:7780,ws://127.0.0.1:7782
# Chat relays (NIP-17 gift wraps: game chat, match room chat, notification DMs).
# Unset: the ndak test bed locally, and wss://nos.lol, wss://relay.primal.net
# everywhere else (not relay.damus.io: it stores gift wraps but serves them to
# no one), plus wss://nostr.mom. Empty also takes that default; `off` switches
# the chat off. Independent of ESPORTS_RELAYS.
# ESPORTS_CHAT_RELAYS=
# Extra relays `esports:game-channels` publishes the channels (kind 40/41) to, on
# top of the chat relays. Unset or empty in production: the public default set in
# config/esports.php; nothing locally. A refusing relay never fails the run.
# ESPORTS_GAME_CHANNEL_RELAYS=
# Notification key (hex or nsec) for NIP-17 DMs; its own key, never the league key.
ESPORTS_NOTIFICATION_NSEC=
# League key (hex or nsec): signs the season chain events (2156, 2158, 2154).
# Without it Block 0 cannot be released and rated play stays closed.
ESPORTS_LEAGUE_NSEC=
# The site's mutes and bans go out as the league key's public NIP-51 mute list (kind 10000), on top of
# the newest list a Nostr client wrote for that key (its private part and other tags stay). On by default;
# false is the kill switch (nothing is read, signed or republished). Nothing is signed unless every write relay of
# the key's NIP-65 relay list among ESPORTS_RELAYS answered; relays unreachable from the server are left out:
# ESPORTS_PUBLISH_MUTE_LIST=false
# ESPORTS_MUTE_LIST_UNREACHABLE=wss://nos.lol,wss://relay.damus.io
# Trust key (hex or nsec): signs the trust ranks (30382), the anchor list and its description.
# Never the league key. Without it no trust ranks exist and rated play stays closed.
ESPORTS_TRUST_NSEC=
# Badge key (hex or nsec): signs the NIP-58 rank badges (30009, 8) on every rank change.
# Never the league key. Without it no badge is signed.
ESPORTS_BADGE_NSEC=
# Rated blitz (true once the lobby offers the Rated choice). Off: no chess win mines.
ESPORTS_RATED_CHESS=false
# Foreign avatars through the einundzwanzig-group image proxy (config esports.image_proxy_url).
# Empty: browsers load kind-0 pictures from their own hosts. Production: https://group.einundzwanzig.space/img
# IMG_PROXY_URL=
# wire:navigate between the shell's pages (config esports.navigate, on by default). false: plain page loads everywhere.
# ESPORTS_NAVIGATE=true
# Web Push VAPID keys (php artisan esports:vapid-keys). Never commit real keys.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Production uses the portal's Reverb server as a second app (no own reverb:start):
#   REVERB_HOST=ws.portal.einundzwanzig.space  REVERB_PORT=443  REVERB_SCHEME=https
#   REVERB_APP_ID / REVERB_APP_KEY / REVERB_APP_SECRET = the portal's REVERB_ESPORTS_APP_* values
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

TWENTYONE_NOSTR_NSEC=
TWENTYONE_NOSTR_NPUB=
TWENTYONE_STREAM_SOURCE=
TWENTYONE_STREAM_PREPARED=
TWENTYONE_STREAM_HLS_DIR=
TWENTYONE_STREAM_URL=
TWENTYONE_STREAM_FFMPEG=
TWENTYONE_STREAM_FFPROBE=
TWENTYONE_STREAM_MUSIC_DIR=
TWENTYONE_STREAM_RSVG_CONVERT=
TWENTYONE_STREAM_VIEWERS_DIR=

TWENTYONE_STREAM_RELAYS=

# Stream chat bot (P22): kind-1311 tips and facts in the stream chat.
# Off unless both are set; its own key (hex or nsec), never the league or stream key.
ESPORTS_STREAM_BOT_ENABLED=false
ESPORTS_STREAM_BOT_NSEC=
# Relays the bot reads human chat messages from (empty: it only waits out 45 min).
ESPORTS_STREAM_BOT_CHAT_RELAYS=
# e.g. 23-07 (Europe/Berlin); empty = no quiet hours.
ESPORTS_STREAM_BOT_QUIET_HOURS=

# Automatic casual cups (P25): games whose cup series runs, comma-separated
# (chess, rocket-league, ea-sports-fc-26, ea-sports-fc-27, age-of-empires-2; the board
# games are correspondence only and run no cup). Needs the league key.
ESPORTS_CASUAL_CUP_GAMES=chess,rocket-league,ea-sports-fc-26,ea-sports-fc-27,age-of-empires-2

# Board games next to chess (nine men's morris, checkers): off until they are
# playable. Both the switch and the game's own switch must be on.
ESPORTS_BOARD_GAMES=false
ESPORTS_BOARD_GAME_NINE_MENS_MORRIS=false
ESPORTS_BOARD_GAME_CHECKERS=false
# Rated board games (P6): the rated queue, and with it mining for board game
# wins; needs a live season and Trusted players who list each other.
ESPORTS_RATED_BOARD_GAMES=false

# Score games (highscore / time attack, plan "AoE2 und Trackmania", P4): no real
# game yet. The demo game runs the whole flow (leaderboard tournaments, manual
# submissions, admin review); keep it off in production.
ESPORTS_SCORE_GAME_DEMO=false
# User agent of every HTTP score source (name + contact URL).
# ESPORTS_SCORE_POLLER_USER_AGENT="einundzwanzig-esports (+https://example.org)"

# TrackMania Nations Forever on our own dedicated server (plan "Trackmania und
# Restposten"): the weekly time attack, read by `php artisan tmnf:listen`.
# Locally `scripts/tmnf-server.sh up` starts the server in Docker and writes
# TMNF_XMLRPC_PASSWORD (the SuperAdmin password) into .env.
ESPORTS_TMNF=false
# TMNF_XMLRPC_HOST=127.0.0.1
# TMNF_XMLRPC_PORT=5005
# TMNF_XMLRPC_USER=SuperAdmin
# TMNF_XMLRPC_PASSWORD=
# What players see to join: the server name, and its host:port or server login.
# TMNF_SERVER_NAME="TWENTY ONE"
# TMNF_SERVER_ADDRESS=
# TMNF_SERVER_LOGIN=

# Hyperbitcoinization (plan "Hyperbitcoinization"): live and correspondence matches on the server's rules core.
# Off, its routes do not exist and the registry does not know the game: no lobby, ladder, rules section, list
# entry or card anywhere. Flipping it needs `php artisan optimize` (the cached route table keeps the old state).
ESPORTS_HYPER=false
# Hyperbitcoinization tournaments (every format, clan brackets) in the format chooser; off by default
# (user 2026-10-09: "Turniere erstmal nicht"). Needs ESPORTS_HYPER.
ESPORTS_HYPER_TOURNAMENTS=false
# The league signs rated results and the spectators' poll of Hyperbitcoinization matches on Nostr; off by
# default. Needs ESPORTS_HYPER and the league key (ESPORTS_LEAGUE_NSEC).
ESPORTS_HYPER_PUBLISH=false

# Stream chat on /live (P24). Left unset, it reads and posts on the stream's
# relays plus the bot's chat relays; set to an empty value, the chat is off.
# ESPORTS_STREAM_CHAT_RELAYS=wss://relay.primal.net,wss://nostr.mom
# Zap receipts in the chat: always the league's own LNURL server (pool@<host>),
# plus these signers of an earlier address, whose receipts must name its LNURL
# (default: getalby, theben@getalby.com, the profile's lud16 until 2026-10-03).
# ESPORTS_STREAM_ZAP_SIGNERS=
# ESPORTS_STREAM_ZAP_SIGNERS_LUD16=
